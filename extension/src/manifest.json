{
    "manifest_version": 2,
    "name": "web-note",
    "version": "1.0",
  
    "description": "saves your highlites",
	
	"background": {
      "scripts": ["background.js"]
    },
	
    "permissions": [
      "http://*/*",
      "https://*/*" ,
      "webRequest", 
	  "contextMenus",
	  "activeTab",
	  "tabs",
	  "menus"	  
	],  
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["jquery-3.5.1.min.js","app.js","config.js"]
      }
    ]
	
  
  }